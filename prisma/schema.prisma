// ProductRadar database schema.
// Add models one vertical slice at a time, then run `npm run db:migrate`.
// Payment (x402) tables must NOT live here alongside core models — see CLAUDE.md Rule 2.
//
// Some rules can't be expressed in Prisma's schema language (value ranges,
// URL format, non-empty text). Those are enforced as CHECK constraints in the
// migration SQL — see prisma/migrations/*_core_data_models/migration.sql.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ───────────────────────────────────────────────────────────────────

enum SubscriptionTier {
  FREE
  PRO // £29/month
  AGENCY // £149/month
}

// Mirrors Stripe's subscription.status values.
enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAUSED
}

// subscriptionTier is the ONLY field core features read (via
// src/server/auth/entitlements.ts). The stripe*/subscription* fields are
// written exclusively by the billing module (src/server/billing) from Stripe
// webhooks — payment logic stays isolated from business logic (CLAUDE.md Rule 2).
model User {
  id                String           @id @default(uuid(7)) @db.Uuid
  email             String           @unique
  emailVerified     DateTime?        @db.Timestamptz(3)
  name              String?
  image             String?
  // bcrypt hash for email + password sign-in; null for email-link-only accounts.
  // Cleared on the first email-link sign-in while emailVerified is still null.
  passwordHash      String?
  // Sessions signed in before this are treated as signed out (sessions are
  // cookies, so this is how they end). Set by a password reset, by dropping an
  // unproven password, and by an account-page change that signs out other
  // devices; setting or changing a password on the account page otherwise
  // leaves it alone, so nobody is signed out.
  passwordChangedAt DateTime?        @db.Timestamptz(3)
  subscriptionTier  SubscriptionTier @default(FREE)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  // ── Billing (Stripe) — billing module only ──
  stripeCustomerId              String?             @unique
  stripeSubscriptionId          String?             @unique
  subscriptionStatus            SubscriptionStatus?
  subscriptionCurrentPeriodEnd  DateTime?           @db.Timestamptz(3)
  subscriptionCancelAtPeriodEnd Boolean             @default(false)
  subscriptionSyncedAt          DateTime?           @db.Timestamptz(3) // Stripe event time last applied (ignores out-of-order events)
  platformCredits               Int                 @default(0) // fiat credits (1 credit = £0.50); every change is a CreditLedgerEntry

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  creditEntries       CreditLedgerEntry[]
  welcomeGrant        WelcomeGrant?
  bulkJobs            BulkJob[]
  searches            SearchUsage[]

  @@index([subscriptionTier])
}

// ─── Credit ledger (billing module only) ─────────────────────────────────────
// Every change to User.platformCredits, written in the same transaction as the change. A Stripe
// purchase is credited once (unique session id); balanceAfter makes the history auditable.

enum CreditEntryKind {
  PURCHASE // a paid credit pack
  SPEND // credits spent on a Dossier
  REFUND // a spend given back because the request failed
  GRANT // a plan's monthly credits (Agency), on a paid subscription invoice
  WELCOME // a new account's first Standard Dossier, free (once per account)
}

model CreditLedgerEntry {
  id              String          @id @default(uuid(7)) @db.Uuid
  userId          String          @db.Uuid
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            CreditEntryKind
  delta           Int // + purchased or refunded, − spent
  balanceAfter    Int // the user's balance right after this entry
  stripeSessionId String?         @unique // PURCHASE: the Checkout Session that paid for it
  stripeInvoiceId String?         @unique // GRANT: the subscription invoice it was granted for (once per invoice)
  reference       String? // SPEND / REFUND: what it was for (the Dossier id)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt(sort: Desc)])
}

// One "reset your password" email link. Only a SHA-256 hash of the link's
// random token is stored; a link works once, for a short time.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Auth.js (NextAuth) tables — shapes required by @auth/prisma-adapter ─────

model Account {
  id                String   @id @default(uuid(7)) @db.Uuid
  userId            String   @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid(7)) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(3)

  @@id([identifier, token])
}

// ─── Products ────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  brand       String?
  category    String
  description String?
  url         String?  @unique // canonical product page; live ingests upsert on this
  imageUrl    String?
  isSample    Boolean  @default(false) // seeded demo product (fictional brand)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  offers   Offer[]
  evidence Evidence[]
  scores   ProductScore[]

  @@index([category])
  @@index([category, createdAt(sort: Desc)])
}

// ─── Offers ──────────────────────────────────────────────────────────────────

enum Availability {
  IN_STOCK
  OUT_OF_STOCK
  PREORDER
  DISCONTINUED
  UNKNOWN
}

// A price/availability claim from a seller. Evidence-First: every offer must
// point at the Evidence record it was captured from.
model Offer {
  id               String       @id @default(uuid(7)) @db.Uuid
  productId        String       @db.Uuid
  sourceEvidenceId String       @db.Uuid
  merchant         String
  url              String
  price            Decimal      @db.Decimal(12, 2)
  currency         String       @db.Char(3) // ISO 4217, e.g. "USD"
  availability     Availability @default(UNKNOWN)
  observedAt       DateTime     @db.Timestamptz(3)
  // The RRP/MSRP the same page publishes for this listing, in the offer's currency,
  // and the evidence row that records it. Both set, or both empty (CHECK).
  rrp              Decimal?     @db.Decimal(12, 2)
  rrpEvidenceId    String?      @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceEvidence Evidence  @relation("OfferSourceEvidence", fields: [sourceEvidenceId, productId], references: [id, productId], onDelete: NoAction)
  rrpEvidence    Evidence? @relation("OfferRrpEvidence", fields: [rrpEvidenceId, productId], references: [id, productId], onDelete: NoAction)

  @@index([productId, observedAt(sort: Desc)])
  @@index([productId, price])
  @@index([sourceEvidenceId, productId])
  @@index([rrpEvidenceId, productId])
}

// ─── Evidence ────────────────────────────────────────────────────────────────

enum SourceType {
  MANUFACTURER
  RETAILER
  REVIEW
  FORUM
  NEWS
  SOCIAL
  MARKETPLACE
  OTHER
  AD_LIBRARY // an ad transparency library (the Meta Ad Library)
}

// The measurable quantity a piece of evidence reports, if any. The scoring
// engine only does math on these; qualitative evidence (metric = null) is kept
// for humans but never feeds a score. Allowed value ranges (CHECK constraints):
//   RATING           0–5      average star rating
//   REVIEW_COUNT     ≥ 0      whole number of reviews/ratings
//   SENTIMENT        -1–1     net sentiment (-1 all negative, 1 all positive)
//   SEARCH_INTEREST  0–100    relative search-interest index (kept as a fact; no longer scored, v2.0.0)
//   AD_ACTIVE_ADS    ≥ 0      whole number of active ads matching the product in one Ad Library snapshot
enum EvidenceMetric {
  RATING
  REVIEW_COUNT
  SENTIMENT
  SEARCH_INTEREST
  AD_ACTIVE_ADS
}

// One sourced, timestamped, quality-scored fact about a product.
// Evidence-First (CLAUDE.md Rule 3): source, timestamp and quality score are
// all required, have no defaults (callers must supply real values), and are
// range/format-checked at the database level.
model Evidence {
  id           String          @id @default(uuid(7)) @db.Uuid
  productId    String          @db.Uuid
  claim        String // the specific statement this evidence supports
  excerpt      String? // verbatim snippet from the source, if captured
  sourceUrl    String // CHECK: must be http(s)://
  sourceName   String // e.g. "Amazon", "The Verge"
  sourceType   SourceType
  observedAt   DateTime        @db.Timestamptz(3) // when we captured it — required, no default
  publishedAt  DateTime?       @db.Timestamptz(3) // when the source published it, if known
  qualityScore Decimal         @db.Decimal(5, 2) // CHECK: 0–100
  metric       EvidenceMetric? // what number this evidence reports (null = qualitative)
  metricValue  Decimal?        @db.Decimal(14, 4) // CHECK: set iff metric is set, range per metric
  isSample     Boolean         @default(false) // seeded demo data, not a real capture
  contentHash  String? // optional dedupe key for identical captures
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)

  product Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  offers  Offer[]                @relation("OfferSourceEvidence")
  rrpOf   Offer[]                @relation("OfferRrpEvidence")
  scores  ProductScoreEvidence[]

  @@unique([id, productId]) // target for Offer's same-product foreign key
  @@unique([productId, contentHash])
  @@index([productId, observedAt(sort: Desc)])
  @@index([productId, qualityScore(sort: Desc)])
  @@index([sourceType])
  @@index([productId, metric, observedAt(sort: Desc)])
}

// ─── Scores ──────────────────────────────────────────────────────────────────

enum ScoreDimension {
  OVERALL
  VALUE
  QUALITY
  DEMAND
  TREND
  SENTIMENT
}

// A calculated ESTIMATE (CLAUDE.md Rule 4), not a guarantee. Every score keeps
// its confidence, the methodology version that produced it, and links to the
// evidence it was computed from. History is kept: new calculations add rows.
model ProductScore {
  id                 String         @id @default(uuid(7)) @db.Uuid
  productId          String         @db.Uuid
  dimension          ScoreDimension
  value              Decimal        @db.Decimal(5, 2) // CHECK: 0–100
  confidence         Decimal        @db.Decimal(4, 3) // CHECK: 0–1
  methodologyVersion String
  calculatedAt       DateTime       @default(now()) @db.Timestamptz(3)

  product  Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  evidence ProductScoreEvidence[]

  @@index([dimension, value(sort: Desc)])
  @@index([productId, dimension, calculatedAt(sort: Desc)])
}

// Which evidence each score was computed from.
model ProductScoreEvidence {
  scoreId    String @db.Uuid
  evidenceId String @db.Uuid

  score    ProductScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  evidence Evidence     @relation(fields: [evidenceId], references: [id], onDelete: NoAction)

  @@id([scoreId, evidenceId])
  @@index([evidenceId])
}

// ─── x402 agent payments (payments module only — CLAUDE.md Rule 2) ──────────
// Written exclusively by src/server/payments/x402. Nothing in the product,
// evidence or scoring domain reads or references these rows.

enum AgentPaymentStatus {
  RESERVED // signature verified, nonce locked while the request is served
  SETTLED // response delivered and payment settled
}

model AgentPayment {
  id           String             @id @default(uuid(7)) @db.Uuid
  nonce        String             @unique // EIP-3009 authorization nonce — one use only (replay protection)
  payer        String // 0x… wallet that signed
  payTo        String
  network      String // CAIP-2, e.g. "eip155:84532"
  asset        String // token contract
  amount       String // atomic units (USDC has 6 decimals)
  resource     String // URL that was paid for
  resourcePath String? // its path, e.g. "/api/agent/v2/dossier/B0CH33F5P2": what Sign-In-With-X reopens for this payer
  reference    String? // what the payment bought, as the paid route named it (the Dossier id); opaque here
  status       AgentPaymentStatus @default(RESERVED)
  transaction  String? // settlement reference ("mock:" prefix when settled by the mock facilitator)
  validBefore  DateTime           @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  settledAt    DateTime?          @db.Timestamptz(3)

  @@index([payer, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([payer, resourcePath, status])
}

// Sign-In-With-X (x402 extension): each signed proof reopens a purchase once.
model SiwxNonce {
  nonce   String   @id // the nonce in the signed Sign-In-With-Ethereum message
  address String // the wallet that signed it
  usedAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([usedAt])
}

// ─── v2 Dossiers ─────────────────────────────────────────────────────────────
// Each Dossier as it was delivered, so a buyer can reopen it without new provider calls. Written by
// src/services/dossierStore.ts; no payment data here (the payment row points at the Dossier id).

model DossierRecord {
  id          String    @id // the Dossier's id
  productKey  String // marketplace and product id, e.g. "amazon.co.uk:B0CH33F5P2"
  body        Json      @db.Json // the 8-part Dossier exactly as delivered (json, not jsonb: keeps the text as sent)
  sample      Boolean   @default(false) // development sample data
  // A summary of the body, for listing purchases without reading every Dossier.
  title       String?
  verdict     String? // LAUNCH / TEST / AVOID, or WITHHELD
  confidence  Float?
  generatedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([productKey, createdAt(sort: Desc)])
}

// 48-hour cache of built Dossiers, one per product: a repeat request inside two days can reuse the
// evidence instead of paying the providers again (CLAUDE.md Rule 8). Replaced when rebuilt; what each
// buyer received stays in DossierRecord. Not read or written yet: the Dossier service adopts it next.
model DossierCache {
  id          String   @id @default(uuid(7)) @db.Uuid
  marketplace String // e.g. "amazon.co.uk"
  productId   String // the marketplace's own id (Amazon: ASIN)
  dossier     Json     @db.Json // the 8-part Dossier, as built
  generatedAt DateTime @db.Timestamptz(3) // when its evidence was read
  expiresAt   DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + '48:00:00'::interval)")) @db.Timestamptz(3) // 48 hours on
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([marketplace, productId])
  @@index([expiresAt])
}

// Free verdicts (the landing page's paste box, no account) that made live provider calls, per UTC day: the
// site-wide cap (FREE_VERDICTS_PER_DAY) that bounds what anonymous checks can spend. Cache hits aren't
// counted, and nothing about the visitor is stored.
model FreeVerdictDay {
  day  DateTime @id @db.Date
  used Int      @default(0)
}

// A new account's free first Dossier: one row per account ever (the primary key is the guarantee), written
// in the same transaction as its WELCOME credits.
model WelcomeGrant {
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credits   Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

// A visitor who gave their email to unlock a free breakdown on the homepage check (lead capture). One row
// per address (stored lower-case). Marketing email needs its own, unticked-by-default consent (PECR): the
// time it was given is kept with it. Nothing here is a user account.
model Lead {
  id               String       @id @default(uuid(7)) @db.Uuid
  email            String       @unique
  marketingConsent Boolean      @default(false)
  consentAt        DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  unlocks          LeadUnlock[]
}

// Each product a lead unlocked the breakdown for: the first 3 are free (FREE_BREAKDOWNS_PER_LEAD), and
// unlocking the same product again doesn't count twice.
model LeadUnlock {
  id         String   @id @default(uuid(7)) @db.Uuid
  leadId     String   @db.Uuid
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  productKey String // "amazon.co.uk:<ASIN>"
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([leadId, productKey])
}

// Welcome grants per UTC day: the site-wide cap (WELCOME_DOSSIERS_PER_DAY) that bounds what fake sign-ups
// could spend, whatever addresses they come from.
model WelcomeGrantDay {
  day  DateTime @id @db.Date
  used Int      @default(0)
}

// OAuth tokens a data provider issued for the owner's own account (today: AliExpress Drop Shipping).
// The app renews them before they expire and keeps the newest pair here, so a restart or deploy doesn't
// fall back to the older pair in the environment. The tokens themselves are encrypted (AES-256-GCM, key
// derived from AUTH_SECRET); only their expiry times are readable.
model ProviderToken {
  provider         String    @id // e.g. "aliexpress"
  sealed           String // the encrypted { accessToken, refreshToken }
  accessExpiresAt  DateTime? @db.Timestamptz(3)
  refreshExpiresAt DateTime? @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
}

// ─── Daily snapshots (src/jobs/dailySnapshot.ts) ─────────────────────────────
// One product's day: best-sellers rank, price and sales velocity, each with its source (CLAUDE.md
// Rule 3). Twelve weeks of these give Momentum its slope. Appended once per product, day and
// provider; never updated.

model TrendSnapshot {
  id             String   @id @default(uuid(7)) @db.Uuid
  marketplace    String // e.g. "amazon.co.uk"
  productId      String // the marketplace's own id (Amazon: ASIN)
  snapshotDate   DateTime @db.Date // the UTC day it describes
  rank           Int? // best-sellers rank in rankCategory; null = not reported that day
  rankCategory   String?
  pricePence     Int? // selling price in minor units (pence, cents); null = no price that day
  currency       String? // ISO 4217, set whenever pricePence is
  salesVelocity  Int? // units per month; null = not stated
  velocityMethod String? // how salesVelocity was measured, e.g. the lower bound of Amazon's "5K+ bought in past month"
  provider       String // e.g. "rainforest", "keepa"
  sourceUrl      String
  observedAt     DateTime @db.Timestamptz(3)
  quality        Int // 0–100, by how the values were obtained
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([marketplace, productId, snapshotDate, provider])
  @@index([marketplace, productId, snapshotDate(sort: Desc)])
}

// One search through /api/search (billing module only): what Pro's 100 free searches a month are
// counted from. A paid search also has its CreditLedgerEntry; the query itself isn't kept.
model SearchUsage {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  free      Boolean // true: one of Pro's free searches; false: it cost a credit
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
}

// ─── Agency bulk jobs ────────────────────────────────────────────────────────
// An Agency upload of up to 100 ASINs, each scored as a Standard Dossier in the background. One credit
// per ASIN is taken when the job is created (one SPEND ledger entry per item, referencing the item's
// Dossier id); an item that fails is refunded.

enum BulkJobStatus {
  PENDING // created, waiting to start
  RUNNING
  DONE // every item finished (some may have failed)
}

enum BulkItemStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model BulkJob {
  id         String        @id @default(uuid(7)) @db.Uuid
  userId     String        @db.Uuid
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     BulkJobStatus @default(PENDING)
  total      Int
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  finishedAt DateTime?     @db.Timestamptz(3)
  items      BulkJobItem[]

  @@index([userId, createdAt(sort: Desc)])
}

model BulkJobItem {
  id        String         @id @default(uuid(7)) @db.Uuid
  jobId     String         @db.Uuid
  job       BulkJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  position  Int // its row in the upload, from 1
  asin      String
  status    BulkItemStatus @default(PENDING)
  dossierId String         @unique // fixed when the job is made: the credit spend and the stored Dossier both use it
  error     String? // why it failed, in plain words
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([jobId, asin])
  @@index([jobId, status])
}

// ─── Ad Momentum (Phase 3: the Viral Demand Engine, src/services/metaAds.ts) ──
// Which products are watched on the Meta Ad Library, a dated snapshot of each check (appended, never
// overwritten: momentum is the change between them), and every ad behind a snapshot's counts, cited by
// its public Ad Library page. Catalog watches also write an AD_ACTIVE_ADS Evidence row per snapshot, which
// is what the TREND score is calculated from (scoring v2.0.0).

enum AdSearchKind {
  KEYWORD // the product's key words, any order (Meta: KEYWORD_UNORDERED)
  BRAND // a brand name as an exact phrase (Meta: KEYWORD_EXACT_PHRASE)
}

model AdWatch {
  id            String               @id @default(uuid(7)) @db.Uuid
  productKey    String // "catalog:<Product.id>" or "amazon.co.uk:<ASIN>"
  searchTerms   String // CHECK: 1–100 characters (Meta's limit)
  kind          AdSearchKind         @default(KEYWORD)
  countries     String[] // ad_reached_countries, e.g. {GB,IE,DE,FR,ES,IT,NL}; CHECK: at least one
  active        Boolean              @default(true)
  lastCheckedAt DateTime?            @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  snapshots     AdMomentumSnapshot[]

  @@unique([productKey, searchTerms, kind])
  @@index([active, lastCheckedAt])
}

model AdMomentumSnapshot {
  id                 String          @id @default(uuid(7)) @db.Uuid
  watchId            String          @db.Uuid
  snapshotDate       DateTime        @db.Date // the UTC day it describes
  observedAt         DateTime        @db.Timestamptz(3)
  activeAds          Int // CHECK: counts ≥ 0, scaling and new ads ≤ active
  scalingAds         Int
  advertisers        Int
  newAds7d           Int
  longestRunningDays Int?
  medianAgeDays      Int?
  euReach            BigInt? // sum of Meta's EU reach estimates, where reported
  truncated          Boolean // the search stopped early: the counts are lower bounds
  confidence         Decimal         @db.Decimal(4, 3) // CHECK: 0–1
  methodologyVersion String
  watch              AdWatch         @relation(fields: [watchId], references: [id], onDelete: Cascade)
  ads                AdObservation[]

  @@unique([watchId, snapshotDate])
  @@index([watchId, snapshotDate(sort: Desc)])
}

model AdObservation {
  snapshotId String             @db.Uuid
  libraryId  String // Meta's ad id; its public page is facebook.com/ads/library/?id=<libraryId>
  pageId     String
  pageName   String
  startedAt  DateTime?          @db.Timestamptz(3)
  platforms  String[]
  euReach    Int?
  scaling    Boolean
  snapshot   AdMomentumSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@id([snapshotId, libraryId])
  @@index([libraryId])
}
