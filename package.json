{
  "name": "product-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:start": "node scripts/db-start.mjs",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "db:verify": "tsx scripts/verify-schema.ts",
    "test": "vitest run",
    "db:rescore": "tsx scripts/rescore.ts",
    "products:import": "tsx scripts/import-products.ts",
    "trends:enrich": "tsx scripts/enrich-trends.ts",
    "ads:momentum": "tsx scripts/ad-momentum.ts",
    "data:refresh": "tsx scripts/refresh-data.ts && tsx scripts/enrich-trends.ts scripts/data/trend-keywords-2026-10.json",
    "fx:update": "tsx scripts/update-fx-rates.ts",
    "agent:test": "tsx scripts/test-agent-client.ts",
    "mcp:build": "npm --prefix mcp install --no-audit --no-fund && npm --prefix mcp run build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@coinbase/cdp-sdk": "1.58.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.6",
    "framer-motion": "14.1.1",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.0",
    "server-only": "^0.0.1",
    "stripe": "23.0.0",
    "undici": "^8.11.2",
    "viem": "2.57.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
