{
  "name": "product-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:start": "node scripts/db-start.mjs",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "db:verify": "tsx scripts/verify-schema.ts",
    "test": "vitest run",
    "db:seed": "prisma db seed",
    "db:rescore": "tsx scripts/rescore.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "agent:test": "tsx scripts/test-agent-client.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.6",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "prisma": "7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "23.0.0",
    "undici": "^8.11.2",
    "viem": "2.57.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
