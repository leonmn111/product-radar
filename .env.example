# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
# Local dev: `npm run db:start` runs a Postgres server matching this URL.
# Production: use your hosted database URL (Neon, Supabase, Railway, etc.).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/product_radar?schema=public"

# ── Authentication (Auth.js) ────────────────────────────────────────────────
# Random secret that signs login sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Needed when running `next start` locally or self-hosting; most hosts detect this automatically.
AUTH_TRUST_HOST=true
# Sign-in emails are sent with Resend (free tier: 3,000 emails/month) — https://resend.com
# Leave empty in development: the sign-in link is printed in the server terminal instead.
AUTH_RESEND_KEY=""
# Sender address. "onboarding@resend.dev" only delivers to your own Resend account email;
# verify your own domain in Resend to email anyone.
EMAIL_FROM="ProductRadar <onboarding@resend.dev>"

# ── Billing (Stripe) ────────────────────────────────────────────────────────
# Use TEST keys (sk_test_…) until you are ready to take real payments.
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=""
# Dashboard → Developers → Webhooks (endpoint: <your site>/api/billing/webhook), or
# `stripe listen --forward-to localhost:3000/api/billing/webhook` locally.
STRIPE_WEBHOOK_SECRET=""
# Public site URL used in Stripe redirect links. Defaults to the request's own address.
APP_URL=""

# ── x402 agent API (/api/agent/v1/*) ────────────────────────────────────────
# "mock"        verifies real signed payment authorizations but does not move funds
#               (local testing only; refused in production).
# "facilitator" verifies and settles on-chain through an x402 facilitator.
# Empty = agent API disabled.
X402_MODE=""
# CAIP-2 network: "eip155:84532" = Base Sepolia testnet (default, test USDC only),
# "eip155:8453" = Base mainnet (real USDC — needs a facilitator that supports it).
X402_NETWORK=""
# Facilitator base URL. Default: https://x402.org/facilitator (free, testnet only) on testnet,
# https://api.cdp.coinbase.com/platform/v2/x402 (Coinbase, needs the CDP key below) on mainnet.
X402_FACILITATOR_URL=""
# Wallet address that receives agent payments (USDC on Base).
X402_PAY_TO=""
# Price per request in USDC.
X402_PRICE_USDC="0.01"
# Coinbase Developer Platform secret API key — required for the Coinbase facilitator (Base mainnet).
# Create one at https://portal.cdp.coinbase.com. First 1,000 settlements a month are free, then $0.001 each.
CDP_API_KEY_ID=""
CDP_API_KEY_SECRET=""

# SerpApi key for Google Trends search interest (npm run trends:enrich). Free plan: 250 searches
# a month, one per product per run. Sign up at https://serpapi.com/users/sign_up.
SERPAPI_API_KEY=""

# Live search (v2) — see ARCHITECTURE.md
RAINFOREST_API_KEY=""          # Amazon US + UK via rainforestapi.com
ALIEXPRESS_APP_KEY=""          # AliExpress Open Platform affiliate API
ALIEXPRESS_APP_SECRET=""
ALIEXPRESS_TRACKING_ID=""
KEEPA_API_KEY=""               # Keepa API (paid): Amazon UK price + sales-rank history for Momentum
LIVE_SAMPLE_DATA=""            # "on" = the /search page uses recorded/sample data (development only)
CREDIT_PACKS_ON_SALE=""        # "on" = sell credit packs with a live Stripe key (after a test-mode run)
